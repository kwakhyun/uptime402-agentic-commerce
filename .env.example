# Uptime402 environment reference. This file contains no credentials.
#
# It is a superset for three different processes; do not source it wholesale.
# Copy only the relevant section into an ignored per-service env file. Cloud Run
# injects PORT=8080. Production entrypoints reject FIRESTORE_EMULATOR_HOST.

# Gemini (control-plane only). Prefer Vertex AI + attached service-account ADC
# on Cloud Run. For local Developer API use, set one key only in an ignored file.
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Local ADC path only; do not mount or create a service-account key for Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=

# Shared managed Firestore namespace. All three live services must use the same
# project, database, and prefix. `FIRESTORE_EMULATOR_HOST=127.0.0.1:8089` is
# test-only and must never be passed to a production entrypoint.
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_PREFIX=uptime402

# Fixed Devnet identity used by payment-executor and vendor-agent.
SOLANA_CLUSTER_LABEL=devnet
SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
X402_NETWORK_ID=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_SDK_NETWORK_ID=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_DECIMALS=6
SOLANA_RPC_URL=https://api.devnet.solana.com
# Verification-only secondary endpoint when SOLANA_RPC_URL is private/nonstandard.
SOLANA_SECONDARY_RPC_URL=https://api.devnet.solana.com
# Official x402 test facilitator verified against pinned @x402/core 2.20.0.
# Runtime startup still checks /supported for the exact Solana Devnet scheme.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Public/private service origins discovered during the Cloud Run bootstrap.
# Each value is an exact credential-free HTTPS origin with no path or fragment.
CONTROL_PLANE_ORIGIN=
VENDOR_AGENT_ORIGIN=
PUBLIC_VENDOR_ORIGIN=
PAYMENT_EXECUTOR_ORIGIN=
EXECUTOR_EXPECTED_AUDIENCE=

# Shared public identity pins. Offer and receipt fields intentionally pin the
# same vendor Agent Card authority; that authority differs from outcome/payer/payee.
VENDOR_AGENT_ID=uptime402-owned-vendor
VENDOR_OFFER_SIGNER_PUBLIC_KEY=
VENDOR_OFFER_SIGNER_KEY_ID=
VENDOR_RECEIPT_PUBLIC_KEY=
VENDOR_RECEIPT_KEY_ID=
CONTROL_PLANE_OUTCOME_PUBLIC_KEY=
CONTROL_PLANE_OUTCOME_KEY_ID=

# control-plane live-flow runtime. The outcome key is its only signing secret.
# Paths must be absolute and point inside the corresponding service-only root.
CONTROL_PLANE_OUTCOME_KEY_PATH=
CONTROL_PLANE_OUTCOME_SECRET_ROOT=
# Human operator authentication terminates at the control-plane. The audience
# is exact, and principals are comma-separated verified Google email claims.
CONTROL_PLANE_OPERATOR_AUDIENCE=
CONTROL_PLANE_OPERATOR_PRINCIPALS=
# Dormant by default. When true, the public OAuth Web client ID must exactly
# equal CONTROL_PLANE_OPERATOR_AUDIENCE. The browser sends only the ephemeral
# Google ID token; the request itself is read from the server-owned path below.
CONTROL_PLANE_UI_LIVE_TRIGGER_ENABLED=false
CONTROL_PLANE_UI_GOOGLE_CLIENT_ID=
CONTROL_PLANE_UI_LIVE_REQUEST_PATH=
CONTROL_PLANE_UI_LIVE_REQUEST_ROOT=
# One Firestore-guarded demo action slot. Rotate only after manual reconciliation.
CONTROL_PLANE_DEMO_RUN_SLOT=finalist-demo-1
CONTROL_PLANE_DEMO_MANDATE_ID=mandate-finalist-demo-1
# Optional capture-only convenience: after the same bodyless Google OIDC
# callback, arm this immutable server-mounted signed mandate before the fresh
# incident action. This still uses the audited operator route and private
# executor administration boundary; no signer key is mounted in control-plane.
CONTROL_PLANE_DEMO_AUTO_ARM_ENABLED=false
CONTROL_PLANE_DEMO_SIGNED_MANDATE_PATH=
CONTROL_PLANE_DEMO_SIGNED_MANDATE_ROOT=
# Set to CONTROL_PLANE_ORIGIN/api/dependency-health. It independently rereads
# the hash-bound paid route and returns the observed activation/state.
RECOVERY_HEALTH_PROBE_URL=
HTTP_TIMEOUT_MS=5000
HTTP_MAX_RESPONSE_BYTES=1048576
# Cloud Run capture uses `capture` and omits both hash variables. Its UI is
# always LIVE UNVERIFIED even if stale artifacts exist in the image. After
# evidence:capture + evidence:verify, rebuild an immutable image and use
# `final` with the exact hashes of both files below.
UPTIME402_UI_EVIDENCE_STAGE=capture
UPTIME402_UI_EVIDENCE_SHA256=
UPTIME402_UI_VERIFICATION_REPORT_SHA256=

# payment-executor production runtime. This service alone reads the existing
# low-balance Devnet payer key. Never paste key bytes into an env variable.
CONTROL_PLANE_SERVICE_ACCOUNT=
# Current private-executor IAM makes the proxied caller the control-plane SA.
# This is not proof of a human-authenticated admin route; see deploy/README.md.
OPERATOR_PRINCIPAL=
MANDATE_ISSUER_PRINCIPAL=
MANDATE_SIGNER_PUBLIC_KEY=
MANDATE_SIGNER_KEY_ID=
EXECUTOR_WALLET_KEYPAIR_PATH=
EXECUTOR_WALLET_SECRET_ROOT=
EXECUTOR_WALLET_PUBLIC_KEY=
ALLOWED_VENDOR_ORIGINS=
ESTIMATED_NETWORK_FEE_LAMPORTS=100000

# vendor-agent production runtime. The offer catalog is an immutable, already
# signed two-offer JSON artifact made by the same authority used by the mounted
# receipt key; the live service receives only that receipt-capable key mount.
VENDOR_AGENT_NAME=Uptime402 Recovery Vendor
VENDOR_AGENT_DESCRIPTION=Owned vendor agent for paid incident recovery resources.
VENDOR_TENANT=uptime402-owned-vendor
VENDOR_OFFER_CATALOG_PATH=
VENDOR_OFFER_CATALOG_ROOT=
VENDOR_RECEIPT_KEY_PATH=
VENDOR_RECEIPT_SECRET_ROOT=
VENDOR_USDC_RECIPIENT=
# Public executor address used only to re-verify an already-settled recovery.
# Cloud Run renders this from EXECUTOR_WALLET_PUBLIC_KEY; never put key bytes here.
VENDOR_EXPECTED_PAYER_PUBLIC_KEY=
# Public Cloud Run OIDC authorization pins for fulfillment-only reconciliation.
VENDOR_RECONCILE_EXPECTED_AUDIENCE=
VENDOR_RECONCILE_CONTROL_PLANE_PRINCIPAL=
# Observed from the official test facilitator /supported on 2026-08-03.
# Vendor startup rejects drift instead of silently selecting another signer.
X402_FACILITATOR_FEE_PAYER=CKPKJWNdJEqa81x7CkZ14BVPiY6y16Sxs7owznqtWYp5
X402_MAX_TIMEOUT_SECONDS=300
SETTLEMENT_CONFIRMATION_ATTEMPTS=5
SETTLEMENT_CONFIRMATION_DELAY_MS=1000

# Deployment renderer inputs. Names/versions are non-secret references; every
# version must be a numeric, version-pinned Secret Manager version, never latest.
PROJECT_ID=
GCP_REGION=asia-northeast3
ARTIFACT_REPOSITORY=uptime402
IMAGE_TAG=
CONTROL_PLANE_SERVICE_NAME=uptime402-control-plane
PAYMENT_EXECUTOR_SERVICE_NAME=uptime402-payment-executor
VENDOR_AGENT_SERVICE_NAME=uptime402-vendor-agent
EXECUTOR_SERVICE_ACCOUNT=
VENDOR_SERVICE_ACCOUNT=
EXECUTOR_SIGNER_SECRET_NAME=
EXECUTOR_SIGNER_SECRET_VERSION=
VENDOR_RECEIPT_SECRET_NAME=
VENDOR_RECEIPT_SECRET_VERSION=
CONTROL_PLANE_OUTCOME_SECRET_NAME=
CONTROL_PLANE_OUTCOME_SECRET_VERSION=
CONTROL_PLANE_DEMO_REQUEST_SECRET_NAME=
CONTROL_PLANE_DEMO_REQUEST_SECRET_VERSION=
CONTROL_PLANE_DEMO_MANDATE_SECRET_NAME=
CONTROL_PLANE_DEMO_MANDATE_SECRET_VERSION=
VENDOR_OFFER_CATALOG_SECRET_NAME=
VENDOR_OFFER_CATALOG_SECRET_VERSION=

# Local existing-key-only mandate provisioning CLI. All paths must remain in
# ignored owner-only directories; never paste key/token bytes into this file.
MANDATE_UNSIGNED_PATH=
MANDATE_UNSIGNED_ROOT=
MANDATE_OUTPUT_PATH=
MANDATE_OUTPUT_ROOT=
MANDATE_SIGNER_KEYPAIR_PATH=
MANDATE_SIGNER_KEYPAIR_ROOT=
SIGNED_MANDATE_PATH=
SIGNED_MANDATE_ROOT=

# Local protected operator CLI. OPERATOR_ID_TOKEN_PATH points to a short-lived
# Google OIDC token file and is never printed or copied into captures.
OPERATOR_ID_TOKEN_PATH=
OPERATOR_ID_TOKEN_ROOT=
MANDATE_ID=
MANDATE_REVOKE_REASON=
MANDATE_REVOKED_AT=
INCIDENT_RUN_REQUEST_PATH=
INCIDENT_RUN_REQUEST_ROOT=
INCIDENT_RUN_CAPTURE_PATH=
INCIDENT_RUN_CAPTURE_ROOT=
# Owner-only independently verified settlement fragment and exclusive-create
# output used by `pnpm evidence:collect-denials`. No key material is accepted.
DENIAL_SETTLEMENT_CAPTURE_PATH=
DENIAL_SETTLEMENT_CAPTURE_ROOT=
DENIAL_PROMOTION_FRAGMENT_PATH=
DENIAL_PROMOTION_FRAGMENT_ROOT=
