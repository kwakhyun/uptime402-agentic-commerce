{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@uptime402/domain": ["packages/domain/src/index.ts"],
      "@uptime402/policy": ["packages/policy/src/index.ts"],
      "@uptime402/payments": ["packages/payments/src/index.ts"],
      "@uptime402/persistence": ["packages/persistence/src/index.ts"],
      "@uptime402/vendor-agent": ["services/vendor-agent/src/index.ts"],
      "@uptime402/payment-executor": ["services/payment-executor/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next"]
}
